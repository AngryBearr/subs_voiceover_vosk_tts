{
  "mode": "accurate",
  "modes": {
    "fast": {"asr": "whisper-large-v3", "fuse": []},
    "accurate": {"asr": "cohere-transcribe", "fuse": ["whisper-large-v3"]}
  },
  "diarizer": "pyannote-community-1",
  "ocr": {"enabled": true, "fps": 2.0},
  "llm": {
    "model": "openai/gpt-6.1-sol",
    "opencode": ["openai/*"],
    "router": "orcarouter",
    "fallback": true,
    "stages": {
      "stress": ["openai/gpt-6.1-sol", "anthropic/claude-sonnet-5.5", "openrouter:google/gemini-4-argon"],
      "stress_screen": "openai/gpt-6-luna"
    }
  },
  "translate": {
    "cps": 14.0,
    "extend": 0.6,
    "tts_profile": null,
    "parallel": 4
  },
  "dub": {
    "interjections": "dense"
  },
  "voiceover": {
    "config": "voiceover_config.json",
    "engine": "vosk",
    "engines": {
      "vosk": {"voices": {"female": 49, "male": 56}},
      "teratts": {"voices": {"female": "ru_f1", "male": "ru_m5"}, "device": "cuda", "target_syl_per_sec": 5.0,
                  "sample_rate": 44100}
    },
    "policy": {"base_syl_per_sec": 5.0, "target_lag_ms": 250, "weight_early": 5.0},
    "units": {"enabled": false},
    "normalization": {"keep_input_yo_homographs": true},
    "stress_check": true,
    "speech_check": true
  },
  "mix": {
    "duck_db": 12.0,
    "mux": true
  },
  "crowd": {"enabled": false, "voices": 3, "gain_db": -4.0}
}
